  :memberOf <Element/548846d3-1b12-11ea-8239-782bcb5df6ac> .
<Element/07c28bdc-9119-11e8-b852-782bcb5df6ac> a :Element ;
  :elementID "2.C.7" ;
  :elementName "Arts and Humanities" ;
  :description "Knowledge of facts and principles related to the branches of learning concerned with human thought, language, and the arts." ;
  :memberOf <Element/548846d3-1b12-11ea-8239-782bcb5df6ac> .
