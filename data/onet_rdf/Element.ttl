  :memberOf <Element/07c28845-9119-11e8-b852-782bcb5df6ac> .
<Element/07c28906-9119-11e8-b852-782bcb5df6ac> a :Element ;
  :elementID "2.C.5.b" ;
  :elementName "Therapy and Counseling" ;
